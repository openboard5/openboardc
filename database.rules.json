{
  "rules": {
    "usernameIndex": {
      ".read": false,
      ".write": false
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "rating": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber() && newData.val() % 1 === 0 && newData.val() >= 100 && newData.val() <= 5000"
        },
        "$other": {
          ".write": false
        }
      }
    },
    "publicGames": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['roomCode', 'hostName', 'createdAt'])",
        "roomCode": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-HJ-NP-Z2-9]{6}$/)"
        },
        "hostName": {
          ".validate": "newData.isString() && newData.val().length <= 18"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
